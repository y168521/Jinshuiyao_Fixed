      "id": "PAT-001",
      "category": "concurrency",
      "severity": "P0",
      "title": "共享容器读-改-写无锁",
      "description": "多线程环境下对全局 dict/set/list 做读-改-写操作未加锁保护，导致数据丢失或状态损坏",
      "symptoms": [
        "数据条目丢失",
        "字典键值不一致",
        "间歇性 KeyError/ValueError"
      ],
      "code_pattern": "global_dict[key] = value  # 无锁",
      "fix_pattern": "with _LOCK: global_dict[key] = value",
