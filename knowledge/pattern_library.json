    {
      "id": "PAT-002",
      "category": "concurrency",
      "severity": "P0",
      "title": "状态恢复缺失（try 内改状态无 finally）",
      "description": "try 块内修改全局/实例状态（如 switch_provider），但无 finally 恢复，异常后状态损坏",
      "symptoms": [
        "异常后系统行为异常",
        "provider 卡在中间状态",
        "重复调用报错"
      ],
      "code_pattern": "try: self.provider = new_p  # 无 finally 恢复",
      "fix_pattern": "old = self.provider; try: self.provider = new_p; ...; finally: self.provider = old",
