        "--status-error": "var(--copper)",
        "--status-pending": "var(--ice)",
        "--chart-1": "var(--ice)",
        "--chart-2": "var(--jade)",
        "--chart-3": "#6e6e80",
        "--chart-4": "var(--copper)",
        "--chart-5": "rgba(53, 55, 64, 0.6)"
      }
    },
    "system-dark": {
      "label": "系统默认·深色中性",
      "kind": "system",
      "vars": {
        "--deep": "#1a1a1a",
        "--card-bg": "#232323",
        "--ink": "#e6e6e6",
        "--gold": "#d97757",
        "--ice": "#8ab4f8",
        "--jade": "#4a9d7f",
        "--copper": "#c97a6d",
        "--status-online": "var(--jade)",
        "--status-offline": "rgba(230, 230, 230, 0.3)",
        "--status-warning": "#c79a4f",
        "--status-error": "var(--copper)",
        "--status-pending": "var(--ice)",
        "--chart-1": "var(--ice)",
        "--chart-2": "var(--jade)",
        "--chart-3": "var(--gold)",
        "--chart-4": "var(--copper)",
        "--chart-5": "rgba(230, 230, 230, 0.65)"
      }
    }
